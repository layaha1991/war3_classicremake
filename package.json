{
  "name": "war3-classicremake",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --parallel --filter @war3/server --filter @war3/web dev",
    "build:deploy": "pnpm --filter @war3/web build",
    "start": "pnpm --filter @war3/server start",
    "start:public": "pnpm build:deploy && pnpm --filter @war3/server start"
  },
  "engines": {
    "node": ">=20"
  }
}
